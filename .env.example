# Optional local overrides — copy to `.env.local` (gitignored) to point the
# shell at a microfrontend you are running yourself instead of its live URL.
#
# In the cart & checkout repo:  npm run build && npm run preview
# then uncomment the line below and run `npm run dev` here.

# VITE_MFE_CART=http://localhost:4173/mfe/luxe-cart-checkout.js
# VITE_MFE_CATALOG=http://localhost:4174/mfe/luxe-catalog.js
# VITE_MFE_ACCOUNT=http://localhost:4175/mfe/luxe-account.js
